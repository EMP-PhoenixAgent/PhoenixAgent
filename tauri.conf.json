{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phoenix Agent",
  "version": "0.8.3",
  "identifier": "com.phoenix.agent",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Phoenix Agent",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "transparent": false,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libsoup-3.0-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "signingIdentity": null,
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    }
  }
}
